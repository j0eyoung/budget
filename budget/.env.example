# Copy this file to .env and fill in your own values. Never commit .env.

# One-time setup token from bridge.simplefin.org. The app claims it on first
# start and stores the resulting access URL in data/secrets.db. You can leave
# this blank and paste the token into the Accounts tab instead.
SIMPLEFIN_SETUP_TOKEN=

# AI features use the Claude Code CLI on your subscription. On this PC the CLI's
# own login is used. Optional fallback token from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=sonnet

# Only needed when the app runs somewhere other than this PC (e.g. Home Assistant)
# and another machine or add-on should query it. Any long random string.
API_TOKEN=

PORT=8099
DATA_DIR=./data
